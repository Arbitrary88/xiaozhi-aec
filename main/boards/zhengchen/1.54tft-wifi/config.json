{
    "manufacturer": "zhengchen",
    "type": "zhengchen-1.54tft-wifi",
    "target": "esp32s3",
    "builds": [
        {
            "name": "zhengchen-1.54tft-wifi",
            "sdkconfig_append": [
                "CONFIG_USE_AUDIO_PROCESSOR=y",
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_USE_WAKE_WORD_INTERRUPT_ONLY=y",
                "CONFIG_WAKE_WORD_DETECTION_IN_LISTENING=n",
                "CONFIG_USE_CUSTOM_WAKE_WORD=y",
                "CONFIG_USE_AFE_WAKE_WORD=n",
                "CONFIG_CUSTOM_WAKE_WORD=\"ni hao xiao niu\"",
                "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"你好小牛\"",
                "CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=35",
                "CONFIG_SR_MN_CN_MULTINET6_QUANT=y"
            ]
        }
    ]
}